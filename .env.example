# ---- redroid 实例镜像(8~15 均有官方镜像) ----
# redroid/redroid:11.0.0-latest / 12.0.0-latest / 13.0.0-latest / 14.0.0-latest / 15.0.0-latest
REDROID_IMAGE=redroid/redroid:12.0.0-latest

# ---- GPU 直通设备(host 渲染模式时挂载给实例) ----
GPU_DEVICE=/dev/dri

# ---- scrcpy 推流参数 ----
SCRCPY_BITRATE=8000000
SCRCPY_FPS=30

# ---- Web 对外端口 ----
WEB_PORT=80

# ---- Windows Docker Desktop 本机调试后端时使用 ----
# DOCKER_SOCKET=npipe:////./pipe/docker_engine
